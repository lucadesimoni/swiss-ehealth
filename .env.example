# Copy to .env and fill in. Every value is optional locally; production
# refuses to start without the ones marked REQUIRED.

# -- deployment -------------------------------------------------------------
EHEALTH_ENVIRONMENT=local              # local | staging | production
EHEALTH_SERVICE_NAME=ch.ehealth.dossier
EHEALTH_ISSUER=https://dossier.example.ch
EHEALTH_DATABASE_URL=sqlite+pysqlite:///./ehealth.db
# production: postgresql+psycopg://user:password@db.internal/ehealth

# -- data sovereignty -------------------------------------------------------
EHEALTH_DATA_REGION=ch                 # ch | ch-li
EHEALTH_ALLOWED_PROCESSOR_DOMAINS=[".ch",".swiss"]

# -- key material -----------------------------------------------------------
# REQUIRED in production. Generate with `make keygen`. In a real deployment
# this is injected from an HSM/KMS-backed secret store, never a file.
EHEALTH_ROOT_KEY=

# Bump a version to rotate that key. Old material stays verifiable and
# decryptable, so rotation needs no flag day.
EHEALTH_KEY_VERSION_FIELD_ENCRYPTION=1
EHEALTH_KEY_VERSION_LOOKUP_INDEX=1
EHEALTH_KEY_VERSION_TOKEN_SIGNING=1
EHEALTH_KEY_VERSION_AUDIT_LEDGER=1

# Keep an AEAD-sealed copy of the AHVN13 so blind indices can be rebuilt and
# lawful disclosure can be answered. false = zero-retention: nothing can ever
# re-identify, and key rotation requires re-enrolment.
EHEALTH_STORE_SEALED_AHVN=true

# -- tokens -----------------------------------------------------------------
EHEALTH_SESSION_TOKEN_TTL_SECONDS=900
EHEALTH_REFRESH_TOKEN_TTL_SECONDS=43200
EHEALTH_CAPABILITY_TOKEN_TTL_SECONDS=600
EHEALTH_VISITOR_TOKEN_TTL_SECONDS=14400
EHEALTH_EMERGENCY_TOKEN_TTL_SECONDS=7200
EHEALTH_MAX_TOKEN_TTL_SECONDS=86400
EHEALTH_CLOCK_SKEW_SECONDS=30

# -- SwissID (REQUIRED in production) ---------------------------------------
EHEALTH_SWISSID_ISSUER=https://login.swissid.ch
EHEALTH_SWISSID_CLIENT_ID=
EHEALTH_SWISSID_CLIENT_SECRET=
EHEALTH_SWISSID_REDIRECT_URI=https://dossier.example.ch/auth/callback
# In-process fake provider. Production refuses to start with this on.
EHEALTH_USE_MOCK_IDP=true

# -- second factor ----------------------------------------------------------
EHEALTH_OTP_LENGTH=6
EHEALTH_OTP_TTL_SECONDS=300
EHEALTH_OTP_MAX_ATTEMPTS=5
EHEALTH_LOGIN_MAX_ATTEMPTS_PER_HOUR=10

# Empty SMTP host = messages are collected in memory (development only).
EHEALTH_SMTP_HOST=
EHEALTH_SMTP_PORT=587
EHEALTH_SMTP_FROM=noreply@dossier.example.ch

# -- enrolment API ----------------------------------------------------------
# Shared secret for the back-office endpoints (register person/institution,
# open dossier, link SwissID). Empty = those endpoints return 404, which is
# the right default.
EHEALTH_ADMIN_API_KEY=

# -- retention --------------------------------------------------------------
EHEALTH_DOSSIER_RETENTION_YEARS=20
EHEALTH_AUDIT_RETENTION_YEARS=20
